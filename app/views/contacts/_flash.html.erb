<%# The banner above the list. Also re-rendered by the delete/undo turbo streams. %>
<% if notice %>
  <div role="status" class="alert alert-success alert-soft mb-4 flex items-center justify-between">
    <span><%= notice %></span>
    <% if undo_token %>
      <%= button_to "Undo", restore_contacts_path, params: { token: undo_token }, class: "btn btn-sm" %>
    <% end %>
  </div>
<% end %>
<% if alert %>
  <div role="alert" class="alert alert-warning alert-soft mb-4"><%= alert %></div>
<% end %>
