<%# Side index + letter sections. Each section's contacts are lazy-loaded in chunks (ContactsController#section),
    so the page stays small however many contacts there are. %>
<div id="phonebook">
  <% if letter_counts.empty? %>
    <div class="rounded-box bg-base-100 p-10 text-center text-base-content/60 shadow-sm">
      No contacts yet.
    </div>
  <% else %>
    <%# Side index: jump to the groups starting with a letter. Letters without contacts are greyed out. %>
    <nav aria-label="Jump to letter"
         class="fixed bottom-2 right-0.5 top-18 z-20 flex flex-col items-center justify-center md:right-3">
      <% Contact::INDEX_LETTERS.each do |letter| %>
        <% if letter_counts.key?(letter) %>
          <a href="#<%= index_section_id(letter) %>"
             class="flex h-[min(1.5rem,3.2dvh)] w-6 items-center justify-center rounded-full text-xs font-semibold text-primary hover:bg-primary hover:text-primary-content md:w-7 md:text-sm"><%= letter %></a>
        <% else %>
          <span aria-hidden="true"
                class="flex h-[min(1.5rem,3.2dvh)] w-6 items-center justify-center text-xs text-base-content/25 md:w-7 md:text-sm"><%= letter %></span>
        <% end %>
      <% end %>
    </nav>

    <%# Phones: number on top, group + location below. Wider screens: three columns.
        No overflow clipping on this box: the row option menus must be able to stick out of it. %>
    <div class="rounded-box bg-base-100 shadow-sm">
      <div class="hidden grid-cols-[1fr_1fr_1fr_2rem] gap-4 border-b border-base-content/10 px-4 py-3 text-sm font-semibold text-base-content/60 md:grid">
        <span>Group</span><span>Location</span><span>Phone number</span><span class="sr-only">Options</span>
      </div>

      <% letter_counts.each do |letter, count| %>
        <%= render "section", letter:, count:, first: letter == letter_counts.keys.first %>
      <% end %>
    </div>
  <% end %>
</div>
