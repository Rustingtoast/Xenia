<% if @contact.nil? %>
  <%= turbo_stream.update "flash", partial: "flash", locals: { notice: nil, alert: "This contact can no longer be restored.", undo_token: nil } %>
<% else %>
  <% if @letter_counts[@contact.index_letter] > 1 %>
    <%# Reload just its letter section, so the contact reappears in its place. %>
    <%= turbo_stream.replace index_section_id(@contact.index_letter), partial: "section",
          locals: { letter: @contact.index_letter, count: @letter_counts[@contact.index_letter],
                    first: @contact.index_letter == @letter_counts.keys.first } %>
  <% else %>
    <%# Its letter was empty: rebuild the list so the section and side-index letter come back. %>
    <%= turbo_stream.replace "phonebook", partial: "phonebook", locals: { letter_counts: @letter_counts } %>
  <% end %>
  <%= turbo_stream.update "contact-count", pluralize(@letter_counts.values.sum, "contact") %>
  <%= turbo_stream.update "flash", partial: "flash", locals: { notice: "Contact restored.", alert: nil, undo_token: nil } %>
<% end %>
