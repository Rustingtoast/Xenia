{
	"name": "xenia",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:lan": "bun --bun vite dev --host",
		"build": "bun --bun vite build",
		"start": "bun ./build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test src",
		"test:e2e": "playwright test",
		"db:setup": "bun scripts/db.ts migrate",
		"db:seed": "bun scripts/db.ts seed",
		"db:reset": "bun scripts/db.ts reset"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-bun": "1.0.0",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "^1.4.4",
		"daisyui": "5.7.50",
		"svelte": "5.57.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.3",
		"vite": "8.3.6"
	}
}
